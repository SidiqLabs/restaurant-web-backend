          "name": "order_checkouts_address_bounds",
          "value": "length(btrim(\"order_checkouts\".\"delivery_address\")) BETWEEN 10 AND 500"
        },
        "order_checkouts_phone_valid": {
          "name": "order_checkouts_phone_valid",
          "value": "\"order_checkouts\".\"phone\" ~ '^[+0-9() -]{8,30}$' AND \"order_checkouts\".\"phone\" ~ '[0-9]'"
